{
    "version": 2,
    "builds": [
        {
            "src": "main.go",
            "use": "@vercel/go"
        }
    ],
    "routes": [
        {
            "src": "/ws",
            "dest": "/ws"
        },
        {
            "src": "/(.*)",
            "dest": "/"
        }
    ],
    "env": {
        "PORT": "8080"
    }
} 